# Másold .env néven, vagy futtasd: python3 telepites.py

# --- Kötelező ---
OPENAI_API_KEY=sk-...

ROHLIK_BASE_URL=https://www.kifli.hu
ROHLIK_USERNAME=email@pelda.hu
ROHLIK_PASSWORD=jelszo

# --- Hang ---
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_MODEL=gpt-realtime

# --- Szöveges mód (kifli.py --gepelt) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra

# --- Opcionális: a magyar normalizáláshoz Gemini is használható ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Opcionális: Home Assistant bevásárlólista ---
# HA_URL=http://192.168.1.10
# HA_TOKEN=...
# HA_TODO=todo.bevasarlolista

# --- Telefonos API (api.py) ---
# Az első indításkor magától generálódik, ha nincs megadva.
# API_TOKEN=

# --- HTTPS mögött (fordított proxy) ---
# Ha a WebSocket külön porton érhető el kívülről (Synology fordított
# proxy, ahol egy gazdanév+port párra csak egy szabály lehet):
# WS_KULSO_PORT=9080
#
# Ha útvonal-alapú a proxy (Tailscale serve --set-path=/ws):
# WS_UTVONAL=/ws

# --- Docker (NAS, szerver) ---
# A konténer ezzel a felhasználóval fusson, hogy írni tudjon az
# adat/ mappába. Kiderítés:  id -u  és  id -g
# KIFLI_UID=1026
# KIFLI_GID=100
